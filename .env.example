PORT=3000
NODE_ENV=development

# Database Configuration
# Option 1: Use DATABASE_URL (recommended for Railway)
# For Railway, get this from your MySQL service variables
# Internal URL (use when deploying TO Railway):
# DATABASE_URL=mysql://root:password@mysql.railway.internal:3306/railway
# 
# External URL (use when connecting FROM your local machine):
# DATABASE_URL=mysql://root:password@containers-us-west-xxx.railway.app:6379/railway

DB_CLIENT=mysql2
DATABASE_URL=mysql://root:password@host:port/database

# Option 2: Use individual connection parameters
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=your_mysql_username
# DB_PASSWORD=your_mysql_password
# DB_NAME=football_wiki
